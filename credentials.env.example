# Copy this to credentials.env and fill in real values
# Then: chmod 600 credentials.env

WP_SITE="https://your-wordpress-site.com"
WP_USERNAME="your_wp_login_username"
# WordPress Application Password (Users → Profile → Application Passwords → Add New)
# Format: xxxx xxxx xxxx xxxx xxxx xxxx (24 chars, 6 groups of 4)
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
